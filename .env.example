# Optional: Firebase für Login + Sync zwischen Geräten.
# Ohne diese Werte speichert die App alles lokal auf dem Gerät.
# Werte findest du in der Firebase Console > Projekteinstellungen > Deine Apps (Web-App).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
